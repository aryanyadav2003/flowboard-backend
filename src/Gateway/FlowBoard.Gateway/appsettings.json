{
  
  "Jwt": {
    "Key": "your-super-secret-development-key-with-at-least-32-characters",
    "Issuer": "FlowBoard",
    "Audience": "FlowBoardUsers"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "workspace-route": {
        "ClusterId": "workspace-cluster",
        "Match": { "Path": "/api/workspaces/{**catch-all}" }
      },
      "board-route": {
        "ClusterId": "board-cluster",
        "Match": { "Path": "/api/boards/{**catch-all}" }
      },
      "list-route": {
        "ClusterId": "list-cluster",
        "Match": { "Path": "/api/lists/{**catch-all}" }
      },
      "card-route": {
        "ClusterId": "card-cluster",
        "Match": { "Path": "/api/cards/{**catch-all}" }
      },
      "comment-route": {
        "ClusterId": "comment-cluster",
        "Match": { "Path": "/api/comments/{**catch-all}" }
      },
      "label-route": {
        "ClusterId": "label-cluster",
        "Match": { "Path": "/api/labels/{**catch-all}" }
      },
      "checklist-route": {
        "ClusterId": "checklist-cluster",
        "Match": { "Path": "/api/checklists/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": { "Address": "http://localhost:5001/" }
        }
      },
      "workspace-cluster": {
        "Destinations": {
          "workspace-destination": { "Address": "http://localhost:5002/" }
        }
      },
      "board-cluster": {
        "Destinations": {
          "board-destination": { "Address": "http://localhost:5003/" }
        }
      },
      "list-cluster": {
        "Destinations": {
          "list-destination": { "Address": "http://localhost:5004/" }
        }
      },
      "card-cluster": {
        "Destinations": {
          "card-destination": { "Address": "http://localhost:5005/" }
        }
      },
      "comment-cluster": {
        "Destinations": {
          "comment-destination": { "Address": "http://localhost:5006/" }
        }
      },
      "label-cluster": {
        "Destinations": {
          "label-destination": { "Address": "http://localhost:5007/" }
        }
      },
      "checklist-cluster": {
        "Destinations": {
          "checklist-destination": { "Address": "http://localhost:5008/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

